{
  "name": "@openedx/openedx-platform-sdk",
  "version": "0.1.0",
  "description": "A client library for accessing Authoring API",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/edly-io/openedx-platform-sdk.git",
    "directory": "javascript"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --ignore-pattern src/generated",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@hey-api/client-axios": "^0.5.0",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.53.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.2.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3"
  }
}
